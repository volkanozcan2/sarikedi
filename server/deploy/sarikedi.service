[Unit]
Description=SARIKEDI sunucusu
After=network.target

[Service]
Type=simple
User=sarikedi
WorkingDirectory=/srv/sarikedi/api
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/srv/sarikedi/data
Environment=STATIC_DIR=/srv/sarikedi/gui
# Gizli bilgiler (ADMIN_PASSWORD_HASH, SESSION_SECRET) bu dosyada tutulur:
#   sudo install -m 600 -o root -g root /dev/null /etc/sarikedi.env
#   sudo nano /etc/sarikedi.env   (iki satır: ADMIN_PASSWORD_HASH=scrypt:...  ve  SESSION_SECRET=...)
# Birim dosyasına gömme: /etc/systemd/system/*.service herkesçe okunur, systemctl show da değişkenleri gösterir.
EnvironmentFile=/etc/sarikedi.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/sarikedi/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
